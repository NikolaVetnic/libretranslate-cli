# Copy to .env to override defaults. Read by docker compose (server) and by the lt CLI.

# --- server (docker-compose.yml)
LT_IMAGE_TAG=latest
LT_PORT=5000
LT_LOAD_ONLY=en,nl,de,fr,es,it
# Worker processes; each one keeps its own copy of the models in RAM.
LT_THREADS=1
LT_UPDATE_MODELS=false
LT_DISABLE_WEB_UI=false

# --- CLI
# Start the container automatically when a command needs it.
LT_AUTOSTART=1
# Stop the container after this many minutes without use (0 = never).
LT_IDLE_TIMEOUT=15
# Pretty output: colors + emoji in the terminal (0 = plain text). Piped output is always plain.
LT_PRETTY=1
